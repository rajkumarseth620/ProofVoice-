# ProofVoice Backend Environment Configuration
# Copy this file to .env and configure local values

# Django Settings
DJANGO_SECRET_KEY=proofvoice-secure-random-key-change-in-production-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (MySQL is the primary production database)
DB_ENGINE=django.db.backends.mysql
DB_NAME=proofvoice_db
DB_USER=proofvoice_user
DB_PASSWORD=replace-with-your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Fallback to SQLite for automated offline testing (Set to True if local MySQL is temporarily offline)
USE_SQLITE_FOR_TESTS=False

# Cross-Origin Resource Sharing (CORS)
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Gnani AI Speech API Configuration (https://docs.gnani.ai/)
# Leave blank to enable graceful demo-mode fallback notices
GNANI_API_KEY=
GNANI_API_BASE_URL=https://api.vachana.ai

# File Upload Security Limits
MAX_UPLOAD_SIZE_MB=5
